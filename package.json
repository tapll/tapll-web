{
  "name": "tapll-web",
  "version": "0.5.0",
  "private": true,
  "description": "Tapll browser analytics SDK (u.js)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "size": "node scripts/size.mjs",
    "check": "pnpm typecheck && pnpm build && pnpm size && pnpm test",
    "cdn:stage": "pnpm check && node scripts/cdn.mjs",
    "deploy:cdn": "pnpm cdn:stage && wrangler deploy -c cdn/wrangler.jsonc"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "esbuild": "^0.25.0",
    "happy-dom": "^18.0.1",
    "terser": "^5.51.2",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.34.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}

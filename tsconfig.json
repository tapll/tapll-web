{
  "compilerOptions": {
    "target": "ES2017", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2017", "DOM", "DOM.Iterable"], "strict": true, "noUncheckedIndexedAccess": false,
    "noEmit": true, "skipLibCheck": true, "types": ["node"], "resolveJsonModule": true,
    "isolatedModules": true, "noImplicitOverride": true
  },
  "include": ["src", "test", "scripts/*.mjs"]
}
